def loading_animation(seconds=1.2):
    chars = ['|', '/', '-', '\\']
    end_time = time.time() + seconds
    i = 0
    while time.time() < end_time:
        sys.stdout.write(f'\r    {C}[{chars[i % 4]}] Establishing secure channel...{W}')
        sys.stdout.flush()
        time.sleep(0.1)
        i += 1
    sys.stdout.write('\r    [✓] Connection established successfully.         \n')

# ---------- CORE FETCH ENGINE (Handles EVERY possible error) ----------
def fetch_data(api_config, target_id):
    headers = {'User-Agent': 'CYBER-WITH-RANJAN-OSINT/v10.0'}
    params = api_config.get("params", {}).copy()
    params[api_config["id_key"]] = target_id
    url = api_config["url"]
    
    print(f"\n    {D}[+] Target URL : {url}{W}")
    print(f"    {D}[+] Parameters : {params}{W}")
    loading_animation(1.0)

    try:
        response = requests.get(url, headers=headers, params=params, timeout=15)
        try:
            raw_data = response.json()
        except json.JSONDecodeError:
            return {
                "status": "ERROR",
                "message": f"Server returned non-JSON response (HTTP {response.status_code})."
            }
        if response.status_code == 200:
            if isinstance(raw_data, dict) and raw_data.get('error'):
                return {"status": "FAILED", "code": response.status_code, "message": f"API Error: {raw_data['error']}", "raw": raw_data}
            return {"status": "SUCCESS", "data": raw_data}
        else:
            error_msg = raw_data.get('message') or raw_data.get('error') or raw_data.get('detail') or f"HTTP {response.status_code}"
            return {"status": "FAILED", "code": response.status_code, "message": error_msg, "raw": raw_data}
    except requests.exceptions.Timeout:
        return {"status": "ERROR", "message": "Connection Timeout! Server is slow."}
    except requests.exceptions.ConnectionError:
        return {"status": "ERROR", "message": "Network Error! Check VPN/Proxy."}
    except Exception as e:
        return {"status": "ERROR", "message": f"Critical Error: {str(e)}"}

